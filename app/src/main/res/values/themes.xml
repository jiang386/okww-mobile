<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OKWW" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">#101418</item>
        <item name="colorSecondary">@color/accent2</item>
        <item name="colorOnSecondary">#101418</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="Theme.OKWW.Fullscreen" parent="Theme.OKWW">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Widget.OKWW.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.OKWW.Button.Accent" parent="Widget.OKWW.Button">
        <item name="android:textColor">#12161B</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="strokeColor">@color/accent</item>
    </style>

    <style name="Widget.OKWW.Button.Danger" parent="Widget.OKWW.Button">
        <item name="android:textColor">@color/danger</item>
        <item name="strokeColor">@color/danger</item>
    </style>

    <style name="Text.OKWW.Section" parent="">
        <item name="android:textColor">@color/accent2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Text.OKWW.Body" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.OKWW.Muted" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
